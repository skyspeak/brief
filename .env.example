# ── delivery (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=re_xxx
RESEND_WEBHOOK_SECRET=whsec_xxx          # from the Resend webhook you create
INBOUND_ADDRESS=brief@yourdomain.com      # shown on /confirm for easy copy-paste when subscribing
DIGEST_TO=skyspeak@gmail.com                # default recipient (personas can override)
DIGEST_FROM=digest@yourdomain.com         # a domain you've verified in Resend
DIGEST_TITLE=THE BRIEF                     # masthead wordmark (optional)

# ── storage (Turso / libSQL) ─────────────────────────────────────────
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=xxx

# ── model (summaries, digests, ask page) ─────────────────────────────
LLM_PROVIDER=gemini                        # primary: claude | gemini | openrouter
LLM_FALLBACK=openrouter                    # optional; auto-fallback when OPENROUTER_API_KEY is set
GEMINI_API_KEY=                            # primary (recommended)
OPENROUTER_API_KEY=                        # fallback when Gemini fails
LLM_MODEL=openrouter/free                  # model slug for OpenRouter fallback only
ANTHROPIC_API_KEY=                         # if provider=claude

# ── scheduling / access ──────────────────────────────────────────────
CRON_SECRET=generate-a-long-random-string # guards /api/digest, /api/preview,
                                          # and is the access key for the ask page (/)
OUTPUT_FORMAT=pdf                         # pdf | html
DIGEST_INTERVAL_DAYS=3                    # minimum days between scheduled sends
DIGEST_WINDOW_DAYS=3                      # how far back to pull newsletters (defaults to interval)
