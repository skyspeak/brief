# ── Gmail (read inbox + send digests) ────────────────────────────────
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx
# Optional: paste refresh token here instead of storing via Setup OAuth
# GMAIL_REFRESH_TOKEN=1//xxx
# GMAIL_ADDRESS=you@gmail.com              # optional override for display
# GMAIL_LABEL=Newsletters                  # only sync messages with this label
# GMAIL_QUERY=label:Newsletters            # or a custom Gmail search query
# GMAIL_SYNC_DAYS=14                       # how far back initial sync looks
# GMAIL_KEEP_IN_INBOX=1                    # set to keep summarized mail in Gmail (default: trash)

# ── digest delivery ──────────────────────────────────────────────────
DIGEST_TO=you@gmail.com                   # recipient (defaults to connected Gmail)
DIGEST_TITLE=THE BRIEF                    # masthead wordmark (optional)

# ── storage (Turso / libSQL) ─────────────────────────────────────────
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=xxx

# ── model (summaries, digests, ask page) ─────────────────────────────
LLM_PROVIDER=gemini                        # primary (default: gemini)
LLM_FALLBACK=openrouter                    # fallback (default: openrouter)
GEMINI_API_KEY=                            # primary — required for Gemini
OPENROUTER_API_KEY=                        # fallback when Gemini fails or is unavailable
LLM_MODEL=openrouter/free                  # OpenRouter model slug only
ANTHROPIC_API_KEY=                         # only if LLM_PROVIDER=claude

# ── scheduling / access ──────────────────────────────────────────────
CRON_SECRET=generate-a-long-random-string   # guards API routes + UI access key
APP_URL=https://your-app.vercel.app        # OAuth redirect base (optional; VERCEL_URL works)
OUTPUT_FORMAT=html                         # html | pdf
DIGEST_INTERVAL_DAYS=3                     # minimum days between scheduled sends
DIGEST_WINDOW_DAYS=3                       # how far back to pull newsletters (defaults to interval)
